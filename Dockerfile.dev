FROM python:3.13-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
# locale が POSIX のままだと tmux がマルチバイト文字を描画できないため UTF-8 を明示する
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        git \
        openssh-client \
        build-essential \
        pkg-config \
        libffi-dev \
        libssl-dev \
        unzip \
        jq \
        less \
        procps \
        iputils-ping \
        sudo \
        zsh \
        tmux \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Node.js のインストール（Claude Code / Codex 用）
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex

# GitHub CLI のインストール
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# uv のインストール
RUN curl -fsSL https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

# ホストの UID/GID を受け取る（デフォルトは 1000）
ARG USER_UID=1000
ARG USER_GID=1000

# ユーザーの作成（ホストと同じ UID/GID で作成）
RUN if ! getent group ${USER_GID} >/dev/null; then \
        groupadd -g ${USER_GID} appuser; \
    fi \
    && useradd -m -u ${USER_UID} -g ${USER_GID} -s /usr/bin/zsh appuser \
    && echo "appuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/appuser \
    && chmod 0440 /etc/sudoers.d/appuser \
    && mkdir -p /app \
    && chown -R ${USER_UID}:${USER_GID} /app \
# named volume の初期所有権・権限の継承用に appuser 所有 700 のダミーを置く（無いと root:root で EACCES。既存 volume は make clean で作り直し）
    && install -d -m 700 -o ${USER_UID} -g ${USER_GID} /home/appuser/.claude \
    && touch /home/appuser/.claude/.keep \
    && chown ${USER_UID}:${USER_GID} /home/appuser/.claude/.keep \
    && install -d -m 700 -o ${USER_UID} -g ${USER_GID} /home/appuser/.codex \
    && touch /home/appuser/.codex/.keep \
    && chown ${USER_UID}:${USER_GID} /home/appuser/.codex/.keep

ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /app

USER appuser

# docker exec は env に TERM が無いと TERM=xterm を注入し 256 色にならないため明示する。
# COLORTERM は接続元端末の truecolor 対応の宣言（モダン端末からの利用前提）。
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# ベースイメージの CMD は python3（REPL）。開発コンテナの常駐プロセスとしては
# シェルのほうが意図が明確なので明示する（tty: true 前提。compose.yaml 参照）。
CMD ["zsh"]
